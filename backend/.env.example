# Backend only. Copy to backend/.env for local development; never commit backend/.env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
CURRENCY=INR
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Used only by the one-time `npm run admin:create` bootstrap script.
ADMIN_USERNAME=Velveteen Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=
